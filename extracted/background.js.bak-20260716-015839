  if (badgeUpdateTimer) clearTimeout(badgeUpdateTimer);
  badgeUpdateTimer = setTimeout(() => {
    badgeUpdateTimer = null;
    updateBadgeFromStorage().catch(() => {});
  }, BADGE_UPDATE_DEBOUNCE_MS);
}

