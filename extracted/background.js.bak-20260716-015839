  // Restore previously-missing fields
  if (nextNotesTrash !== null) {
    toSet["sidebarNotesTrash"] = nextNotesTrash;
  }
  if (nextPomodoroState !== null) {
    toSet["pomodoroState"] = nextPomodoroState;
